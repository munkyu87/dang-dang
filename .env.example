# 개발용 예시입니다. 실제 비밀값은 저장소에 넣지 않습니다.
AUTH_SECRET=replace-with-a-long-random-string
DATABASE_PATH=data/dangdang.sqlite
ADMIN_PASSWORD=change-me
# 관리자 페이지에 저장한 값이 있으면 그 값이 우선합니다.
AI_PROVIDER=mock
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_DAILY_BUDGET_KRW=10000
DAILY_CASE_LIMIT=5
APP_URL=http://localhost:3000
# 카카오 디벨로퍼스 JavaScript 키. 관리자 페이지에 저장한 값이 우선합니다.
KAKAO_JAVASCRIPT_KEY=
# 약관 문의 연락처. 비워 두면 문서에 아직 없다고 표시합니다.
CONTACT_EMAIL=
TRUST_PROXY=0
